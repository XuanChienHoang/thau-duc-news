# Database URL
# For local development with PGlite (embedded):
DATABASE_URL=pglite://./data/pgdata
# For production (e.g. Neon, Supabase, Neon Postgres on Vercel):
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# AI Engine configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Image search API (optional but recommended)
PEXELS_API_KEY=your_pexels_api_key_here

# Brand ID: thau-duc | lang-kinh-duc | mach-duc | spree-nhat-bao
NEXT_PUBLIC_BRAND_ID=thau-duc

# Ingestion settings
INGEST_INTERVAL_MINUTES=30
INGEST_MAX_AI=6
INGEST_MAX_AUTO=10

# Secret for triggering /api/ingest via cron (optional)
CRON_SECRET=your_cron_secret_token

# Admin token for /quan-tri
ADMIN_TOKEN=your_admin_secret_token

